{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vintage Story Server Manager",
  "version": "0.1.0",
  "identifier": "org.vsm.community",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{"title": "Vintage Story Server Manager", "width": 1440, "height": 960, "minWidth": 900, "minHeight": 640}],
    "security": {"csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Manage your own Vintage Story servers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
